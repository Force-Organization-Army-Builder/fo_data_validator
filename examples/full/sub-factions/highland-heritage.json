{
    "$schema": "../../../schema/sub-faction.schema.json",
    "id": "highland-heritage",
    "version": "1.0.0",
    "name": "Highland Heritage",
    "parent": { "faction": "field-army", "versions": ">=1.0.0 <2.0.0" },
    "group": "heritage",
    "description": "Heritages can be combined, so their shared `local-knowledge` rule must be identical. Each adds its own option to the parent's `sidearms` list (`addOptions`); with both taken, the list offers both.",
    "weapons": {
        "broadsword": {
            "id": "broadsword",
            "name": "Broadsword",
            "template": "melee",
            "profiles": [{ "name": "Broadsword", "stats": { "attacks": "1", "damage": "2" } }]
        }
    },
    "addOptions": {
        "sidearms": {
            "broadsword": { "id": "broadsword", "name": "Broadsword", "cost": { "points": 4 }, "weaponRefs": ["broadsword"] }
        }
    },
    "specialRules": {
        "local-knowledge": {
            "id": "local-knowledge",
            "name": "Local knowledge",
            "text": "Deploys after the enemy."
        },
        "mountaineers": {
            "id": "mountaineers",
            "name": "Mountaineers",
            "text": "Ignore difficult terrain on hills."
        }
    }
}
