{
    "$schema": "../../../schema/sub-faction.schema.json",
    "id": "coastal-heritage",
    "version": "1.0.0",
    "name": "Coastal Heritage",
    "parent": { "faction": "field-army", "versions": ">=1.0.0 <2.0.0" },
    "group": "heritage",
    "when": {
        "if": "choice(stance) == defensive",
        "message": "Coastal heritage is only for defensive lists"
    },
    "description": "Adds a cutlass to the parent's shared `sidearms` list with `addOptions`, rather than overriding the whole list, so it combines with the other heritage's addition.",
    "weapons": {
        "cutlass": {
            "id": "cutlass",
            "name": "Cutlass",
            "template": "melee",
            "profiles": [{ "name": "Cutlass", "stats": { "attacks": "2", "damage": "1" } }]
        }
    },
    "addOptions": {
        "sidearms": {
            "cutlass": { "id": "cutlass", "name": "Cutlass", "cost": { "points": 3 }, "weaponRefs": ["cutlass"] }
        }
    },
    "specialRules": {
        "local-knowledge": {
            "id": "local-knowledge",
            "name": "Local knowledge",
            "text": "Deploys after the enemy."
        },
        "amphibious": {
            "id": "amphibious",
            "name": "Amphibious",
            "text": "Ignore water terrain."
        }
    }
}
