{
    "$schema": "../../../schema/faction.schema.json",
    "id": "field-army",
    "version": "1.0.0",
    "name": "Field Army",
    "description": "Uses every faction-level record kind.",
    "game": { "id": "sample-skirmish", "versions": ">=1.0.0 <2.0.0" },
    "defaultGroup": "standard-core",
    "subFactionGroups": {
        "doctrine": {
            "id": "doctrine",
            "name": "Doctrine",
            "description": "Pick at most one.",
            "max": 1
        },
        "heritage": {
            "id": "heritage",
            "name": "Heritage",
            "description": "Pick one; a second if the list includes a Walker.",
            "min": 0,
            "max": "1 + (list.has(unit:walker) ? 1 : 0)"
        }
    },
    "units": {
        "squad": {
            "id": "squad",
            "name": "Infantry Squad",
            "role": "troop",
            "type": "infantry",
            "tags": ["Line"],
            "traits": ["Disciplined"],
            "cost": { "points": 100 },
            "modelCount": 10,
            "additionalModels": { "max": 10, "cost": { "points": 10 } },
            "profiles": [
                {
                    "id": "trooper",
                    "name": "Trooper",
                    "template": "infantry",
                    "stats": {
                        "move": "6",
                        "skill": "4",
                        "wounds": "1",
                        "morale": "7",
                        "save": "4+"
                    },
                    "specialRules": [{ "id": "armoured", "value": "2" }]
                },
                {
                    "id": "sergeant",
                    "name": "Sergeant",
                    "template": "infantry",
                    "tags": ["Sergeant"],
                    "traits": ["Shield"],
                    "stats": {
                        "move": "6",
                        "skill": "3",
                        "wounds": "2",
                        "morale": "8",
                        "save": "4+"
                    },
                    "specialRules": [{ "id": "fearless" }, { "id": "armoured" }]
                }
            ],
            "defaultGear": [
                {
                    "kind": "weapon",
                    "id": "rifle",
                    "perModel": true,
                    "excludeProfiles": { "anyOf": ["Sergeant"] }
                },
                { "kind": "weapon", "id": "rifle", "profileId": "sergeant" },
                { "kind": "equipment", "id": "rations" }
            ],
            "upgrades": {
                "sergeant-melee": {
                    "id": "sergeant-melee",
                    "name": "Sergeant melee weapon",
                    "profileId": "sergeant",
                    "default": "knife",
                    "perModel": { "type": "single" },
                    "options": {
                        "knife": {
                            "id": "knife",
                            "name": "Knife",
                            "cost": { "points": 0 },
                            "weaponRefs": ["knife"]
                        },
                        "axe": {
                            "id": "axe",
                            "name": "Axe",
                            "cost": { "points": 10 },
                            "weaponRefs": ["axe"]
                        }
                    },
                    "restrictions": {
                        "exclusions": [
                            { "kind": "weapon", "id": "twin-blades" }
                        ],
                        "required": [],
                        "requiredAnd": false
                    }
                },
                "sergeant-blades": {
                    "id": "sergeant-blades",
                    "name": "Sergeant twin blades",
                    "profileId": "sergeant",
                    "perModel": { "type": "single" },
                    "replaces": ["sergeant-melee"],
                    "options": {
                        "twin-blades": {
                            "id": "twin-blades",
                            "name": "Twin blades",
                            "cost": { "points": 15 },
                            "weaponRefs": ["twin-blades"],
                            "swaps": [
                                {
                                    "from": { "kind": "weapon", "id": "rifle" },
                                    "to": {
                                        "kind": "weapon",
                                        "id": "twin-blades"
                                    }
                                }
                            ]
                        }
                    }
                },
                "heavy-weapons": {
                    "id": "heavy-weapons",
                    "name": "Heavy weapons",
                    "multiSelect": true,
                    "min": 0,
                    "max": "floor(unit.models() / 5)",
                    "perModel": {
                        "type": "some",
                        "max": 2,
                        "excludeProfiles": { "anyOf": ["Sergeant"] }
                    },
                    "limitBy": [
                        {
                            "kind": "weapon",
                            "id": "rifle",
                            "count": 0.2,
                            "profiles": { "noneOf": ["Sergeant"] }
                        }
                    ],
                    "options": {
                        "cannon": {
                            "id": "cannon",
                            "name": "Cannon",
                            "cost": { "points": 15 },
                            "weaponRefs": ["cannon"],
                            "max": 1,
                            "subChoices": ["mount"]
                        }
                    }
                },
                "trooper-sidearm": {
                    "id": "trooper-sidearm",
                    "name": "Trooper sidearm",
                    "profileId": "trooper",
                    "default": "none",
                    "perModel": { "type": "one-in-x", "everyX": 5, "count": 2 },
                    "swapFrom": { "kind": "weapon", "id": "rifle" },
                    "gearNote": "Sidearm",
                    "options": {
                        "none": {
                            "id": "none",
                            "name": "None",
                            "cost": { "points": 0 }
                        },
                        "sidearms": { "id": "sidearms", "target": "sidearms" }
                    }
                },
                "squad-options": {
                    "id": "squad-options",
                    "name": "Squad options",
                    "multiSelect": true,
                    "perModel": { "type": "one-in-x", "everyX": 5 },
                    "options": {
                        "banner": { "id": "banner", "target": "banner" },
                        "grenades": {
                            "id": "grenades",
                            "name": "Grenades",
                            "cost": { "points": 5 },
                            "equipmentRefs": ["grenades"],
                            "when": {
                                "if": "choice(stance) == offensive",
                                "message": "Offensive forces only"
                            },
                            "effects": [
                                {
                                    "kind": "stat",
                                    "changes": [
                                        {
                                            "stat": "move",
                                            "op": "add",
                                            "value": -1,
                                            "min": 1
                                        },
                                        {
                                            "stat": "save",
                                            "op": "set",
                                            "value": "5+"
                                        }
                                    ],
                                    "profiles": { "noneOf": ["Sergeant"] }
                                },
                                {
                                    "kind": "specialRule",
                                    "rule": { "id": "armoured", "value": "3" }
                                }
                            ]
                        }
                    }
                },
                "full-kit": {
                    "id": "full-kit",
                    "name": "Full kit",
                    "perModel": { "type": "every" },
                    "when": {
                        "if": "list.limit(points) >= 750",
                        "message": "Only in forces of 750 points or more"
                    },
                    "options": {
                        "kit": {
                            "id": "kit",
                            "name": "Full kit",
                            "cost": { "points": 2 },
                            "equipmentRefs": ["rations"]
                        }
                    }
                },
                "extra-kit": {
                    "id": "extra-kit",
                    "name": "Extra kit",
                    "perModel": { "type": "multiple", "max": 3 },
                    "options": {
                        "pack": {
                            "id": "pack",
                            "name": "Pack",
                            "cost": { "points": 1 },
                            "equipmentRefs": ["rations"]
                        }
                    }
                }
            }
        },
        "walker": {
            "id": "walker",
            "name": "Walker",
            "role": "heavy",
