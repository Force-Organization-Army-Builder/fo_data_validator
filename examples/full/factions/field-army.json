            "type": "reserve",
            "slots": [
                {
                    "roles": ["heavy"],
                    "repeat": { "min": 1, "max": 2 },
                    "source": [
                        { "faction": "field-army", "subFactions": "any" },
                        { "faction": "clockwork-guild" }
                    ]
                },
                {
                    "roles": ["support", "heavy"],
                    "source": [
                        { "faction": "field-army", "units": { "roles": ["support"] } },
                        { "faction": "clockwork-guild", "units": { "unitIds": ["siege-construct"] } }
                    ]
                }
            ],
